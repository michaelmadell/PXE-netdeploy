# netdeploy server (ADR 0030, 0031). Extra flags: /etc/default/netdeploy.
# Local changes: `systemctl edit netdeploy` (kept on upgrade).
[Unit]
Description=netdeploy network deployment server
Documentation=https://github.com/michaelmadell/pxe-netdeploy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netdeploy
Group=netdeploy
EnvironmentFile=-/etc/default/netdeploy
ExecStart=/usr/bin/netdeployd -data /var/lib/netdeploy $NETDEPLOY_ARGS
# /var/lib/netdeploy, mode 700, owned by netdeploy (re-owned at start if needed).
StateDirectory=netdeploy
StateDirectoryMode=0700
# Ports below 1024 (DHCP 67, TFTP 69, HTTP 80, HTTPS 443) and raw ICMP for
# the DHCP ping check; nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
UMask=0077
# Everything but the state directory is read-only. A content store elsewhere
# (-content) needs ReadWritePaths= in a drop-in: see /etc/default/netdeploy.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
